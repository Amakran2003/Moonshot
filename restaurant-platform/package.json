{
  "name": "restaurant-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "pnpm run --filter @restaurant-platform/client dev",
    "dev:restaurant": "pnpm run --filter @restaurant-platform/restaurant dev",
    "dev:admin": "pnpm run --filter @restaurant-platform/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "framer-motion": "^11.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "turbo": "^1.12.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}